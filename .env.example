# This file intentionally contains no secrets. Server-only values belong in
# Netlify Environment variables, not in the React build.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Optional: anon key for public reads after applying supabase/migrations/20260914_public_read_rls.sql
# SUPABASE_ANON_KEY=sb_publishable_or_anon_jwt_replace_me
ALLOWED_ORIGINS=https://drrtechradar.org,http://localhost:3000
# Optional: GlitchTip/Sentry DSN for the Netlify API function (server-side)
# GLITCHTIP_DSN=https://publicKey@app.glitchtip.com/projectId

# Frontend (Create React App — must be set at build time for GitHub Pages)
# Public API base URL (no trailing slash after /api). Defaults to the Netlify
# production API if unset.
# REACT_APP_RADAR_API_URL=https://undp-drr-radar-api.netlify.app/api
# Local Netlify Functions: REACT_APP_RADAR_API_URL=http://localhost:8888/api
#
# Public GlitchTip DSN from your project Settings → DSN (safe to expose in the browser).
# Leave unset to disable error reporting.
# REACT_APP_GLITCHTIP_DSN=https://publicKey@app.glitchtip.com/projectId
